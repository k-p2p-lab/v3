# Optional KPL API token for mutating operations.
KPL_API_TOKEN=

# Monitoring UIs are published on localhost only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Set your own password before first startup. Existing Grafana volumes retain
# their stored admin password when this variable changes.
GRAFANA_ADMIN_PASSWORD=replace-with-your-own-password
# Anonymous access is read-only, for local experiment analysis.
GRAFANA_ANONYMOUS_ENABLED=true
